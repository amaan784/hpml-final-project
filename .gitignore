# Python bytecode and test caches (regenerated automatically)
__pycache__/
*.py[cod]
.pytest_cache/

# Local virtualenv (uv sync)
.venv/

# VM-side artifacts: multi-GB quantized checkpoints, local W&B run dirs,
# PyTorch Profiler traces
models/
wandb/
tb/

# Raw run logs (can be large). overnight.sh bundles them into
# results/run_logs_<RUN_ID>.tar.gz, which IS committed as evidence.
results/logs/
results/vllm_serve_logs/
results/bench_*.log
results/overnight.log
